# DB2 connection settings for IBM i (AS400) — copy this file to .env and fill in your real values.
# The app reads these environment variables to connect to the database.
# Note: On IBM i, you don't need a database name — you connect directly to the system
# and access libraries (schemas) in your SQL queries.

# The hostname or IP address of the DB2 server (default is pub400.com)
# DB2_HOSTNAME=pub400.com

# The port the server is listening on (default is 446)
# DB2_PORT=446

# Your IBM i username
DB2_USER=myuser

# Your IBM i password
DB2_PASSWORD=mypassword
